# Bowerscript environment. Copy to .env for local dev, or to .env next to the
# server's docker-compose.yml. Never commit the real .env.

# --- Required --------------------------------------------------------------
GROQ_API_KEY=your_groq_key_here
ANTHROPIC_API_KEY=your_anthropic_key_here

# --- Optional: models ------------------------------------------------------
# Default Whisper model. The per-job UI toggle overrides this; only
# whisper-large-v3-turbo and whisper-large-v3 are accepted from the UI.
# GROQ_WHISPER_MODEL=whisper-large-v3-turbo
# OpenAI-compatible endpoint Whisper requests go to.
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# Claude model for the cleanup pass.
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# --- Optional: storage -----------------------------------------------------
# Where the SQLite library and saved .md files live. The Docker image sets
# this to /data, which Compose mounts from a host directory so the library
# survives restarts and rebuilds. Locally it defaults to ./data.
# DATA_DIR=./data

# --- Optional: YouTube access ----------------------------------------------
# Netscape-format cookies.txt for yt-dlp, from a throwaway Google account.
# Mounted read-only in production; the app copies it to a writable temp path
# because yt-dlp rotates cookies back into the file.
# COOKIES_FILE=/etc/secrets/cookies.txt

# Set 1 to log yt-dlp's full per-client warnings (noisy; for debugging).
# YTDLP_VERBOSE=0

# Set 0 to skip the startup yt-dlp nightly refresh (offline / local dev).
# Read by entrypoint.sh, not the app.
# YTDLP_AUTO_UPDATE=1

# Comma-separated yt-dlp player clients, e.g. "tv". DIAGNOSTICS ONLY — leave
# this unset. yt-dlp's built-in defaults work best and track YouTube's
# changes; a hand-picked list that includes "web" causes
# "The page needs to be reloaded" failures.
# YTDLP_PLAYER_CLIENTS=

# --- Optional: concurrency + tuning ---------------------------------------
# How many jobs may run the full pipeline at once. Keep at 1 on small
# instances — concurrent downloads/ffmpeg are what blow the memory limit.
# MAX_CONCURRENT_JOBS=1
# Audio chunk length in seconds (keeps every Whisper upload under 25 MB).
# CHUNK_SECONDS=600
# Bitrate for the mono 16 kHz mp3 chunks.
# AUDIO_BITRATE=64k
# Words of raw transcript per Claude cleanup call.
# CLEANUP_WINDOW_WORDS=1500
# Max output tokens per cleanup call.
# CLEANUP_MAX_TOKENS=4096

# --- Optional: server ------------------------------------------------------
# Port uvicorn binds. Read by entrypoint.sh, not the app.
# PORT=8000
